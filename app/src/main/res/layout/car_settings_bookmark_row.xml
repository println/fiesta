<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/car_settings_item_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/bookmark_row_thumbnail"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp"
        android:background="@color/car_settings_tonal"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/bookmark_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@android:color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/bookmark_row_host"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/car_settings_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/bookmark_row_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/car_settings_toggle_circle_background"
        android:contentDescription="@string/home"
        android:padding="8dp"
        android:src="@drawable/ic_car_home"
        android:tint="@color/car_settings_on_active" />

    <ImageButton
        android:id="@+id/bookmark_row_heart"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/car_settings_circle_background"
        android:contentDescription="@string/car_settings_favorite"
        android:padding="8dp" />

</LinearLayout>
