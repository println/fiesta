<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/car_toolbar_thickness"
    android:layout_height="@dimen/car_toolbar_thickness">

    <ImageView
        android:id="@+id/engine_button_icon"
        android:layout_width="@dimen/car_search_engine_circle_size"
        android:layout_height="@dimen/car_search_engine_circle_size"
        android:layout_gravity="center"
        android:background="@drawable/car_search_engine_circle"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:padding="@dimen/car_search_engine_icon_padding"
        android:scaleType="fitCenter" />
</FrameLayout>
