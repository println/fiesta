<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_screen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/very_dark_gray"
    android:clickable="true"
    android:elevation="12dp"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/car_toolbar_thickness"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/settings_screen_back"
            android:layout_width="@dimen/car_toolbar_thickness"
            android:layout_height="@dimen/car_toolbar_thickness"
            android:background="@drawable/highlighting_drawable"
            android:contentDescription="@string/webview_back"
            android:src="@drawable/ic_car_back" />

        <TextView
            android:id="@+id/settings_screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:textColor="@android:color/white"
            android:textSize="22sp" />

        <LinearLayout
            android:id="@+id/settings_screen_header_actions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal" />

        <ImageButton
            android:id="@+id/settings_screen_close"
            android:layout_width="@dimen/car_toolbar_thickness"
            android:layout_height="@dimen/car_toolbar_thickness"
            android:background="@drawable/highlighting_drawable"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_car_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/car_settings_divider" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/settings_screen_body"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/settings_screen_voice_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/brandAuxPurple"
            android:clickable="true"
            android:visibility="gone">

            <com.github.zagum.speechrecognitionview.RecognitionProgressView
                android:id="@+id/settings_screen_speech_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clickable="true"
                android:padding="20dp" />

            <TextView
                android:id="@+id/settings_screen_voice_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="32dp"
                android:textColor="@android:color/white"
                android:textSize="24sp" />

            <ImageButton
                android:id="@+id/settings_screen_voice_close"
                android:layout_width="@dimen/car_toolbar_thickness"
                android:layout_height="@dimen/car_toolbar_thickness"
                android:layout_gravity="top|end"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_car_close" />
        </FrameLayout>
    </FrameLayout>

</LinearLayout>
