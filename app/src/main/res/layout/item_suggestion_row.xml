<?xml version="1.0" encoding="utf-8"?>
<!-- Plano 17, B7: uma linha da lista de sugestoes de busca - lupa a
     esquerda, texto no meio, botao de preencher o campo a direita. Usado 4x
     (bind/hide por codigo) dentro de fragment_webview_phone.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingEnd="8dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/suggestion_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        app:srcCompat="@drawable/mozac_ic_search" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/suggestion_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/primaryText"
        android:textSize="15sp" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/suggestion_fill"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/browser_suggestion_fill"
        android:padding="8dp"
        android:visibility="gone"
        app:srcCompat="@drawable/mozac_ic_fill" />

</LinearLayout>
