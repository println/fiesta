<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <Preference
        android:key="pref_donate_header"
        android:layout="@layout/preference_donate_header"
        android:selectable="false"
        android:title="@string/settings_donate_title"
        android:summary="@string/settings_donate_message" />

    <Preference
        android:key="pref_donate_coffee"
        android:layout="@layout/preference_donate_button"
        android:title="@string/settings_donate_coffee">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="@string/settings_donate_coffee_url" />
    </Preference>

    <Preference
        android:key="pref_donate_footer"
        android:layout="@layout/preference_donate_footer"
        android:selectable="false" />

</PreferenceScreen>
