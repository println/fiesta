<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/car_settings_ripple">
    <item>
        <selector>
            <item android:state_activated="true">
                <shape>
                    <solid android:color="@color/car_settings_active" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item>
                <shape>
                    <solid android:color="@color/car_settings_tonal" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
